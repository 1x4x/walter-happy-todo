@model List<TodoModel>
@{var admin=(bool)ViewBag.Admin;}
<section class="hero"><span class="eyebrow">✨ YOUR HAPPY SPACE</span><h1>Make today a <span>happy day.</span></h1><p>Little tasks. Big smiles. Your routines, beautifully organized.</p><div class="stats"><span>📋 @Model.Count tasks</span><span>✨ @Model.Count(x=>x.IsFinished) finished</span><span>🌷 @Model.Count(x=>!x.IsFinished) to go</span></div>@if(admin){<a class="btn" href="/Todo/Create">＋ Add a Todo</a>}else{<p class="hint">Read-only view. Open your private admin link to manage todos.</p>}</section>
<section class="tasks"><div class="sectionhead"><h2>🌸 My Todos</h2><span>@Model.Count items</span></div>
@if(!Model.Any()){<div class="empty">🐈 No todos yet. Add your first happy task!</div>}
@foreach(var t in Model){<article class="todo @(t.IsFinished?"finished":"")" style="border-left:4px solid @t.BorderColor"><div class="todo-top"><div><small>@t.Category @(t.IsImportant?" · ⭐ Important":"")</small><h3>@t.Title</h3>@if(!string.IsNullOrWhiteSpace(t.Description)){<p>@t.Description</p>}<div class="meta"><span>🔁 @t.Recurrence</span>@if(t.Recurrence=="MonthDays"){<span>📅 Days @string.Join(", ",t.MonthDays)</span>}@if(t.NextDueAt!=null){<span>⏰ @t.NextDueAt.Value.ToString("yyyy-MM-dd")</span>}</div></div><span class="status">@(t.IsFinished?"✓ Finished":"○ To do")</span></div>@if(admin){<div class="actions"><form asp-action="Toggle" method="post"><input type="hidden" name="id" value="@t.Id"/><button>@(t.IsFinished?"↶ Mark unfinished":"✓ Mark finished")</button></form><a href="/Todo/Edit/@t.Id">✎ Edit</a><form asp-action="Delete" method="post" onsubmit="return confirm('Delete this todo?')"><input type="hidden" name="id" value="@t.Id"/><button class="danger">🗑 Delete</button></form></div>}</article>}
</section>