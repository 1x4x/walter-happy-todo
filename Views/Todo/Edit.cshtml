@model TodoModel
@{var editing=Model.CreatedAt!=default && Model.Id!=Guid.Empty;var isNew=Model.Title=="";}
<section class="editor"><a href="/">← Back to todos</a><h1>@(isNew?"🌷 Create a Todo":"✏️ Edit Todo")</h1><p>Make it yours — pick a routine, a schedule and a splash of color.</p><form asp-action="Save" method="post"><div asp-validation-summary="All" class="validation"></div><input asp-for="Id" type="hidden"/><label>Quick suggestions</label><input id="suggestion" list="suggestions" placeholder="Search 200+ suggested tasks…" autocomplete="off"/><datalist id="suggestions"></datalist><label asp-for="Title"></label><input asp-for="Title" required maxlength="150"/><label asp-for="Description"></label><textarea asp-for="Description" rows="3"></textarea><label asp-for="Category"></label><select asp-for="Category"><option>General</option><option>Hygiene</option><option>Health</option><option>Home</option><option>Finance</option><option>Work</option><option>Social</option><option>Learning</option><option>Fitness</option><option>Other</option></select><label asp-for="Recurrence">Repeat schedule</label><select asp-for="Recurrence" id="recurrence"><option value="None">Does not repeat</option><option value="Daily">Every day</option><option value="Weekly">Every week</option><option value="Monthly">Every month</option><option value="EveryNDays">Every N days</option><option value="MonthDays">Specific days each month</option></select><div id="intervalWrap"><label asp-for="IntervalDays">Every how many days?</label><input asp-for="IntervalDays" min="1" max="365"/></div><div id="monthWrap"><label>Days of month (comma separated, e.g. 1, 5, 8, 22 or 26)</label><input name="monthDaysText" value="@string.Join(", ",Model.MonthDays)" placeholder="26"/></div><label>4px border color</label><div class="palette">@foreach(var color in TodoPalette.Colors){<label class="swatch" title="@color"><input type="radio" name="BorderColor" value="@color" checked="@(string.Equals(Model.BorderColor,color,StringComparison.OrdinalIgnoreCase))"/><span style="background:@color"></span></label>}</div><label class="check"><input asp-for="IsImportant"/> Important ⭐</label><label class="check"><input asp-for="IsFinished"/> Finished ✓</label><button class="btn" type="submit">💜 Save Todo</button></form></section>
<script src="/js/suggestions.js"></script><script>
const recurrence=document.getElementById('recurrence');function toggleFields(){document.getElementById('intervalWrap').hidden=recurrence.value!=='EveryNDays';document.getElementById('monthWrap').hidden=recurrence.value!=='MonthDays';}recurrence.addEventListener('change',toggleFields);toggleFields();
const suggestion=document.getElementById('suggestion');suggestion.addEventListener('change',()=>{if(window.todoSuggestions.includes(suggestion.value)){document.getElementById('Title').value=suggestion.value;if(/brush|shower|shave|nail|hair|floss|skin|deodorant/i.test(suggestion.value))document.getElementById('Category').value='Hygiene';if(/bill|budget|tax|bank|invoice|rent/i.test(suggestion.value))document.getElementById('Category').value='Finance';}});
</script>